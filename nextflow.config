manifest {
    name = 'gaph_v2'
    description = 'GAPH v2 gene fetch and ortholog-to-target alignment workflow'
}

plugins {
    id 'nf-validation@1.1.3'
}

params {
    stage = 'all'
    ids_file = null
    fetch_dir = null
    outdir = 'results/run'
    fetch_outdir = null
    align_outdir = null
    clinvar_vcf = '/Users/cvv/code/Bioinformatics/course-work/course-work-code/data/clinvar.vcf.gz'

    chunk_size = 10
    datasets_bin = System.getenv('DATASETS_BIN') ?: 'datasets'

    target_assembly_accession = 'GCF_000001405.40'
    target_assembly_name = 'GRCh38.p14'
    target_tax_id = '9606'

    fetch_max_forks = 1
    alignment_max_forks = 2
    taxonomy_batch_size = 200
    taxonomy_file = null

    minimap2_bin = System.getenv('MINIMAP2_BIN') ?: 'minimap2'
    nucmer_bin = System.getenv('NUCMER_BIN') ?: 'nucmer'
    show_coords_bin = System.getenv('SHOW_COORDS_BIN') ?: 'show-coords'
    show_snps_bin = System.getenv('SHOW_SNPS_BIN') ?: 'show-snps'
    bwa_bin = System.getenv('BWA_BIN') ?: 'bwa'
    samtools_bin = System.getenv('SAMTOOLS_BIN') ?: 'samtools'
    varscan_jar = System.getenv('VARSCAN_JAR') ?: "${projectDir}/bin/VarScan.v2.4.6.jar"
    keep_native_alignments = false
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    withName: VALIDATE_IDS {
        cpus = 1
        memory = '1 GB'
        time = '30 min'
    }

    withName: FETCH_PARSE_CHUNK {
        cpus = 1
        memory = { 6.GB * task.attempt }
        time = { 8.h * task.attempt }
        maxForks = params.fetch_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'finish' }
        maxRetries = 3
        scratch = true
        conda = "${projectDir}/envs/fetch.yml"
    }

    withName: MERGE_FETCH_RESULTS {
        cpus = 1
        memory = '4 GB'
        time = '2 h'
        publishDir = [
            path: {
                params.fetch_outdir ?: (params.stage == 'fetch' ? params.outdir : "${params.outdir}/fetch")
            },
            mode: 'copy',
            overwrite: true
        ]
    }

    withName: FETCH_TAXONOMY_PRESETS {
        cpus = 1
        memory = '2 GB'
        time = '2 h'
        errorStrategy = 'retry'
        maxRetries = 3
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: BUILD_ALIGNMENT_TASKS {
        cpus = 1
        memory = '4 GB'
        time = '1 h'
    }

    withName: ALIGN_MINIMAP2_ASM10 {
        cpus = 2
        memory = { 8.GB * task.attempt }
        time = { 4.h * task.attempt }
        maxForks = params.alignment_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'finish' }
        maxRetries = 3
        scratch = true
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: ALIGN_MINIMAP2_ADAPTIVE {
        cpus = 2
        memory = { 8.GB * task.attempt }
        time = { 4.h * task.attempt }
        maxForks = params.alignment_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'finish' }
        maxRetries = 3
        scratch = true
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: ALIGN_NUCMER_COMPARATOR {
        cpus = 2
        memory = { 12.GB * task.attempt }
        time = { 8.h * task.attempt }
        maxForks = params.alignment_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'finish' }
        maxRetries = 3
        scratch = true
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: ALIGN_BWA_PSEUDOREADS {
        cpus = 2
        memory = { 8.GB * task.attempt }
        time = { 4.h * task.attempt }
        maxForks = params.alignment_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'finish' }
        maxRetries = 3
        scratch = true
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: MERGE_ALIGNMENT {
        cpus = 1
        memory = '4 GB'
        time = '2 h'
        publishDir = [
            path: {
                params.align_outdir ?: (params.stage == 'align' ? params.outdir : "${params.outdir}/alignment")
            },
            mode: 'copy',
            overwrite: true
        ]
    }
}

profiles {
    local {
        process.executor = 'local'
    }

    slurm {
        process.executor = 'slurm'
        executor.queueSize = 50
    }
}
