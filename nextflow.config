manifest {
    name = 'gaph_v2'
    description = 'GAPH v2 gene fetch and ortholog-to-target alignment workflow'
}

workDir = System.getenv('GAPH_WORK_DIR') ?: "${System.getenv('TMPDIR') ?: '/tmp'}/gaph_v2_nextflow_work"

plugins {
    id 'nf-validation@1.1.3'
}

params {
    help = false
    stage = 'all'
    ids_file = null
    fetch_dir = null
    events_tsv = null
    segments_tsv = null
    outdir = 'results/run'
    fetch_outdir = null
    align_outdir = null
    annotation_outdir = null
    clinvar_vcf = System.getenv('CLINVAR_VCF') ?: null
    gnomad_cache_dir = System.getenv('GAPH_GNOMAD_CACHE_DIR') ?: null

    chunk_size = 10
    datasets_bin = System.getenv('DATASETS_BIN') ?:
        (new File("${projectDir}/tools/bin/datasets").exists() ? "${projectDir}/tools/bin/datasets" : 'datasets')

    target_assembly_accession = 'GCF_000001405.40'
    target_assembly_name = 'GRCh38.p14'
    target_tax_id = '9606'
    target_annotation_gff3 = System.getenv('GAPH_TARGET_ANNOTATION_GFF3') ?: "${projectDir}/assets/reference/ncbi/refseq/GCF_000001405.40_GRCh38.p14/genomic.gff.gz"

    fetch_max_forks = 2
    fetch_request_stagger_seconds = (System.getenv('GAPH_NCBI_REQUEST_STAGGER_SECONDS') ?: '5') as Integer
    fetch_download_retries = 4
    fetch_download_retry_base_seconds = 30
    alignment_max_forks = 4
    alignment_partition_size = 10
    alignment_strategies = 'all'
    compact_alignment_events = false
    annotation_max_forks = 2

    minimap2_bin = System.getenv('MINIMAP2_BIN') ?: 'minimap2'
    nucmer_bin = System.getenv('NUCMER_BIN') ?: 'nucmer'
    bwa_bin = System.getenv('BWA_BIN') ?: 'bwa'
    samtools_bin = System.getenv('SAMTOOLS_BIN') ?: 'samtools'
    bwa_pseudoread_len = 150
    bwa_pseudoread_step = 75
    bwa_pseudoread_phred = 30
    keep_native_alignments = false

    ensembl_compara_maf_release = '116'
    ensembl_compara_maf_species_set = '92_mammals.epo_extended'
    ensembl_compara_maf_method = 'EPO_EXTENDED'
    ensembl_compara_maf_manifest = System.getenv('ENSEMBL_COMPARA_MAF_MANIFEST') ?: null
    ensembl_compara_maf_base_url = System.getenv('ENSEMBL_COMPARA_MAF_BASE_URL') ?:
        'https://ftp.ensembl.org/pub/release-116/maf/ensembl-compara/multiple_alignments/92_mammals.epo_extended'
    ensembl_compara_maf_max_forks = 3
    ensembl_compara_maf_timeout_seconds = 120
    ensembl_compara_maf_retries = 8
    ensembl_compara_maf_retry_base_seconds = 5.0
    ensembl_compara_maf_retry_max_seconds = 300.0
}

trace {
    enabled = true
    file = "${params.outdir}/reports/nextflow/trace.txt"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/reports/nextflow/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/reports/nextflow/report.html"
    overwrite = true
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: task_scratch {
        scratch = true
    }

    withName: VALIDATE_IDS {
        cpus = 1
        memory = '1 GB'
        time = '30 min'
        conda = "${projectDir}/envs/fetch.yml"
    }

    withName: CHECK_RUNTIME {
        cpus = 1
        memory = '1 GB'
        time = '10 min'
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: FETCH_PARSE_CHUNK {
        cpus = 1
        memory = { 3.GB * task.attempt }
        time = { 8.h * task.attempt }
        maxForks = params.fetch_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'finish' }
        maxRetries = 3
        conda = "${projectDir}/envs/fetch.yml"
    }

    withName: BUILD_FETCH_DATASET {
        cpus = 1
        memory = '4 GB'
        time = '2 h'
        conda = "${projectDir}/envs/fetch.yml"
        publishDir = [
            path: {
                params.fetch_outdir ?: (params.stage == 'fetch' ? params.outdir : "${params.outdir}/fetch")
            },
            mode: 'copy',
            overwrite: true,
            enabled: { params.stage == 'fetch' }
        ]
    }

    withName: FINALIZE_FETCH_OUTPUT {
        cpus = 1
        memory = '1 GB'
        time = '30 min'
        conda = "${projectDir}/envs/fetch.yml"
        publishDir = [
            path: {
                params.fetch_outdir ?: "${params.outdir}/fetch"
            },
            mode: 'copy',
            overwrite: true
        ]
    }

    withName: FETCH_TAXONOMY_PRESETS {
        cpus = 1
        memory = '2 GB'
        time = '2 h'
        errorStrategy = 'retry'
        maxRetries = 3
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: BUILD_ALIGNMENT_TASKS {
        cpus = 1
        memory = '4 GB'
        time = '1 h'
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: ALIGN_MINIMAP2_ASM10 {
        cpus = 3
        memory = { 8.GB * task.attempt }
        time = { 4.h * task.attempt }
        maxForks = params.alignment_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'finish' }
        maxRetries = 3
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: ALIGN_MINIMAP2_ASM20 {
        cpus = 3
        memory = { 8.GB * task.attempt }
        time = { 4.h * task.attempt }
        maxForks = params.alignment_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'finish' }
        maxRetries = 3
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: ALIGN_MINIMAP2_ADAPTIVE {
        cpus = 3
        memory = { 8.GB * task.attempt }
        time = { 4.h * task.attempt }
        maxForks = params.alignment_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'finish' }
        maxRetries = 3
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: ALIGN_NUCMER_COMPARATOR {
        cpus = 3
        memory = { 12.GB * task.attempt }
        time = { 8.h * task.attempt }
        maxForks = params.alignment_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'finish' }
        maxRetries = 3
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: ALIGN_BWA_PSEUDOREADS {
        cpus = 3
        memory = { 8.GB * task.attempt }
        time = { 4.h * task.attempt }
        maxForks = params.alignment_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'finish' }
        maxRetries = 3
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: BUILD_ENSEMBL_COMPARA_MAF_MANIFEST {
        cpus = 1
        memory = '2 GB'
        time = '2 h'
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'finish' }
        maxRetries = 3
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: BUILD_ENSEMBL_COMPARA_MAF_CHUNK_TASKS {
        cpus = 1
        memory = '2 GB'
        time = '1 h'
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: ALIGN_ENSEMBL_COMPARA_MAF {
        cpus = 1
        memory = { 8.GB * task.attempt }
        time = { 8.h * task.attempt }
        maxForks = params.ensembl_compara_maf_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'finish' }
        maxRetries = 3
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: ALIGN_ENSEMBL_COMPARA_MAF_CHUNK {
        cpus = 1
        memory = { 8.GB * task.attempt }
        time = { 8.h * task.attempt }
        maxForks = params.ensembl_compara_maf_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'terminate' }
        maxRetries = 3
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: MERGE_ENSEMBL_COMPARA_MAF_GENE {
        cpus = 1
        memory = { 4.GB * task.attempt }
        time = { 2.h * task.attempt }
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'terminate' }
        maxRetries = 3
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: MERGE_ALIGNMENT {
        cpus = 1
        memory = '4 GB'
        time = '2 h'
        conda = "${projectDir}/envs/alignment.yml"
        publishDir = [
            path: {
                params.align_outdir ?: (params.stage == 'align' ? params.outdir : "${params.outdir}/alignment")
            },
            mode: 'copy',
            overwrite: true
        ]
    }

    withName: MERGE_ALIGNMENT_PARTITION {
        cpus = 1
        memory = '4 GB'
        time = '4 h'
        maxForks = params.alignment_max_forks
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: ANNOTATE_EVENTS {
        cpus = 1
        memory = '8 GB'
        time = '4 h'
        conda = "${projectDir}/envs/alignment.yml"
        publishDir = [
            path: {
                params.annotation_outdir ?: (params.stage == 'annotate' ? params.outdir : "${params.outdir}/annotation")
            },
            mode: 'copy',
            overwrite: true
        ]
    }

    withName: ANNOTATE_EVENTS_PARTITION {
        cpus = 1
        memory = { 24.GB * task.attempt }
        time = '4 h'
        maxForks = params.annotation_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'terminate' }
        maxRetries = 2
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: FINALIZE_ANNOTATION {
        cpus = 1
        memory = '2 GB'
        time = '2 h'
        conda = "${projectDir}/envs/alignment.yml"
        publishDir = [
            path: {
                params.annotation_outdir ?: "${params.outdir}/annotation"
            },
            mode: 'copy',
            overwrite: true
        ]
    }
}

profiles {
    local {
        process.executor = 'local'
    }

    conda {
        conda.enabled = true
        conda.useMicromamba = true
        conda.cacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${projectDir}/.nextflow/conda"
    }

    low_storage {
        cleanup = true
        process.cache = false
        process {
            withName: ANNOTATE_EVENTS {
                cpus = 1
                memory = '8 GB'
                time = '4 h'
                conda = "${projectDir}/envs/alignment.yml"
                publishDir = [
                    path: {
                        params.annotation_outdir ?: (params.stage == 'annotate' ? params.outdir : "${params.outdir}/annotation")
                    },
                    mode: 'move',
                    overwrite: true
                ]
            }
            withName: FINALIZE_ANNOTATION {
                cpus = 1
                memory = '2 GB'
                time = '2 h'
                conda = "${projectDir}/envs/alignment.yml"
                publishDir = [
                    path: {
                        params.annotation_outdir ?: "${params.outdir}/annotation"
                    },
                    mode: 'move',
                    overwrite: true
                ]
            }
            withName: FINALIZE_FETCH_OUTPUT {
                cpus = 1
                memory = '1 GB'
                time = '30 min'
                conda = "${projectDir}/envs/fetch.yml"
                publishDir = [
                    path: {
                        params.fetch_outdir ?: "${params.outdir}/fetch"
                    },
                    mode: 'move',
                    overwrite: true
                ]
            }
        }
    }

    slurm {
        process.executor = 'slurm'
        executor.queueSize = 50
        conda.enabled = true
        conda.useMicromamba = true
        conda.cacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${projectDir}/.nextflow/conda"
        process {
            withLabel: task_scratch {
                scratch = false
            }
        }
    }
}
