manifest {
    name = 'gaph_v2'
    description = 'GAPH v2 end-to-end comparative variant evidence pipeline'
}

workDir = System.getenv('GAPH_WORK_DIR') ?: "${System.getenv('TMPDIR') ?: '/tmp'}/gaph_v2_nextflow_work"
cleanup = true

conda.enabled = true
conda.useMicromamba = true
conda.cacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${projectDir}/.nextflow/conda"

plugins {
    id 'nf-schema@2.7.3'
}

params {
    help = false
    helpFull = false
    ids_file = null
    outdir = 'results/run'
    clinvar_vcf = System.getenv('CLINVAR_VCF') ?: null
    gnomad_cache_dir = System.getenv('GAPH_GNOMAD_CACHE_DIR') ?:
        (System.getenv('GAPH_ROOT') ? "${System.getenv('GAPH_ROOT')}/cache/gnomad" : null)
    vep_backend = System.getenv('GAPH_VEP_BACKEND') ?: 'rest'
    vep_release = System.getenv('GAPH_VEP_RELEASE') ?
        (System.getenv('GAPH_VEP_RELEASE') as Integer) : null
    vep_executable = System.getenv('GAPH_VEP_EXECUTABLE') ?: 'vep'
    vep_cache_dir = System.getenv('GAPH_VEP_CACHE_DIR') ?: null
    vep_result_cache_dir = System.getenv('GAPH_VEP_RESULT_CACHE_DIR') ?: null
    vep_result_cache_tile_size_bp = (System.getenv('GAPH_VEP_RESULT_CACHE_TILE_SIZE_BP') ?: '1000000') as Integer
    vep_forks = (System.getenv('GAPH_VEP_FORKS') ?: '4') as Integer

    chunk_size = 10
    target_annotation_gff3 = System.getenv('GAPH_TARGET_ANNOTATION_GFF3') ?: "${projectDir}/assets/reference/ncbi/refseq/GCF_000001405.40_GRCh38.p14/genomic.gff.gz"

    fetch_max_forks = 4
    alignment_max_forks = 21
    alignment_partition_size = 10
    alignment_strategies = 'default'
    annotation_max_forks = 8
}

validation.logging.unrecognisedParams = 'error'

trace {
    enabled = true
    file = "${params.outdir}/reports/nextflow/trace.txt"
    overwrite = true
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,attempt,cpus,memory,time'
}

timeline {
    enabled = true
    file = "${params.outdir}/reports/nextflow/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/reports/nextflow/report.html"
    overwrite = true
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: task_scratch {
        scratch = true
    }

    withName: VALIDATE_IDS {
        cpus = 1
        memory = '1 GB'
        time = '30 min'
        conda = "${projectDir}/envs/fetch.yml"
    }

    withName: CHECK_RUNTIME {
        cpus = 1
        memory = '1 GB'
        time = '10 min'
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: FETCH_PARSE_CHUNK {
        cpus = 1
        memory = { 3.GB * task.attempt }
        time = { 8.h * task.attempt }
        maxForks = params.fetch_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'finish' }
        maxRetries = 3
        conda = "${projectDir}/envs/fetch.yml"
    }

    withName: BUILD_FETCH_DATASET {
        cpus = 1
        memory = '4 GB'
        time = '2 h'
        conda = "${projectDir}/envs/fetch.yml"
    }

    withName: FINALIZE_FETCH_OUTPUT {
        cpus = 1
        memory = '1 GB'
        time = '30 min'
        conda = "${projectDir}/envs/fetch.yml"
        publishDir = [
            path: { "${params.outdir}/fetch" },
            pattern: '{manifest.json,input.ids.tsv,*.tsv.gz,sequences}',
            mode: 'move',
            overwrite: true
        ]
    }

    withName: FETCH_TAXONOMY {
        cpus = 1
        memory = '2 GB'
        time = '2 h'
        errorStrategy = 'retry'
        maxRetries = 3
        conda = "${projectDir}/envs/fetch.yml"
    }

    withName: BUILD_ALIGNMENT_TASKS {
        cpus = 1
        memory = '4 GB'
        time = '1 h'
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: ALIGN_MINIMAP2 {
        cpus = 3
        memory = {
            def retryStepGb = (meta.pseudoread_len as Integer) > 0 ? 16 : 8
            (meta.alignment_memory_gb as Integer).GB + retryStepGb.GB * (task.attempt - 1)
        }
        time = { 4.h * task.attempt }
        maxForks = params.alignment_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'finish' }
        maxRetries = 3
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: ALIGN_NUCMER_COMPARATOR {
        cpus = 3
        memory = { 12.GB * task.attempt }
        time = { 8.h * task.attempt }
        maxForks = params.alignment_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'finish' }
        maxRetries = 3
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: ALIGN_BWA_PSEUDOREADS {
        cpus = 3
        memory = {
            (meta.alignment_memory_gb as Integer).GB + 8.GB * (task.attempt - 1)
        }
        time = { 4.h * task.attempt }
        maxForks = params.alignment_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'finish' }
        maxRetries = 3
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: MERGE_ALIGNMENT {
        cpus = 1
        memory = '4 GB'
        time = '2 h'
        conda = "${projectDir}/envs/alignment.yml"
        publishDir = [
            path: { "${params.outdir}/alignment" },
            pattern: '{manifest.json,evidence,failures.tsv.gz}',
            mode: 'copy',
            overwrite: true
        ]
    }

    withName: MERGE_ALIGNMENT_PARTITION {
        cpus = 1
        memory = { 8.GB * task.attempt }
        time = '4 h'
        maxForks = params.alignment_max_forks
        errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
        maxRetries = 2
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: PREPARE_ANNOTATION_CONTEXTS {
        cpus = 1
        memory = '2 GB'
        time = '1 h'
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: ANNOTATE_EVENTS_PARTITION {
        cpus = 1
        memory = { meta.annotation_memory_gb.GB + (32.GB * (task.attempt - 1)) }
        time = '4 h'
        maxForks = params.annotation_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'terminate' }
        maxRetries = 2
        conda = "${projectDir}/envs/alignment.yml"
    }

    withName: ANNOTATE_VEP_PARTITION {
        cpus = { params.vep_backend == 'local' ? params.vep_forks : 2 }
        memory = { 8.GB * task.attempt }
        time = '1 d'
        maxForks = params.annotation_max_forks
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'terminate' }
        maxRetries = 2
        conda = "${projectDir}/envs/vep.yml"
    }

    withName: FINALIZE_ANNOTATION {
        cpus = 1
        memory = { 8.GB * task.attempt }
        time = '2 h'
        errorStrategy = { task.exitStatus in [104, 134, 137, 140, 143] ? 'retry' : 'terminate' }
        maxRetries = 2
        conda = "${projectDir}/envs/alignment.yml"
        publishDir = [
            path: { "${params.outdir}/annotation" },
            pattern: '{manifest.json,variant_annotations,event_variant_map,failures.tsv.gz}',
            mode: 'move',
            overwrite: true
        ]
    }

    withName: BUILD_EVIDENCE_INVENTORY {
        cpus = 1
        memory = '1 GB'
        time = '10 min'
        conda = "${projectDir}/envs/fetch.yml"
        publishDir = [
            path: { "${params.outdir}" },
            mode: 'copy',
            overwrite: true
        ]
    }
}

profiles {
    slurm {
        process.executor = 'slurm'
        executor.queueSize = 50
        process {
            withLabel: task_scratch {
                scratch = false
            }
        }
    }
}
